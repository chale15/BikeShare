paste0("Joint probability for x = 1, lambda = 0.5: ", joint_1_5)
f_x_given_lambda <- function(x, lambda) {
prob <- (lambda**x)/(factorial(x)*(1 + lambda + (lambda**2)/2 + (lambda**3)/6 +
(lambda**4)/24))
return(prob)
}
pi_lambda <- function(lambda) {
if(lambda == 0.5) {return(0.1)
}else if(lambda == 1) {return(0.2)
}else if(lambda == 2) {return(0.7)
}else{return(0)}
}
joint_0_5 <- f_x_given_lambda(x=0, lambda = .5) * pi_lambda(lambda = .5)
joint_1_5 <- f_x_given_lambda(x=1, lambda = .5) * pi_lambda(lambda = .5)
paste0("Joint probability for x = 0, lambda = 0.5: ", round(joint_0_5, 4)
paste0("Joint probability for x = 1, lambda = 0.5: ", round(joint_1_5, 4)
